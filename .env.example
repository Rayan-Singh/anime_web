# Standalone demo-media override.
VITE_DEMO_VIDEO_URL=https://example.com/your-authorized-video.mp4

# Account sessions and per-user Continue Watching data.
# Set a long random value in production so sessions survive server restarts.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_SECURE=false

# Metadata catalog: auto, anilist, jikan, or kitsu. Auto tries them in that order.
CATALOG_SOURCE=auto

# Official/licensed provider configuration. This file stays server-side.
PROVIDER_BASE_URL=https://licensed-api.example.com
PROVIDER_API_KEY=replace-with-your-local-key
PROVIDER_AUTH_HEADER=Authorization
PROVIDER_AUTH_SCHEME=Bearer
PROVIDER_TIMEOUT_MS=12000
PROVIDER_REFERER=
PROVIDER_ORIGIN=
PROVIDER_USER_AGENT=

# Optional route overrides. Values below match the compatibility contract.
PROVIDER_HOME_PATH=/home
PROVIDER_SEARCH_PATH=/search
PROVIDER_INFO_PATH=/info/{slug}
PROVIDER_EPISODES_PATH=/episodes/{slug}
PROVIDER_SERVERS_PATH=/servers/{slug}/{episode}

# The adapter also recognizes `sources`, `mirrors`, `streamingLinks`,
# `episode_links`, and `links`, including nested `data` payloads.

# Set these when the provider uses AniList IDs in its server route and returns
# an embeddable `dataLink` in each server object.
PROVIDER_RESOLVE_BY_ANILIST_ID=false
PROVIDER_EMBED_LINKS=false

# Optional for dual-audio embeds that use one URL for both languages. The
# configured parameter/value is added to each SUB/DUB embed URL server-side.
PROVIDER_EMBED_AUDIO_PARAM=
PROVIDER_EMBED_SUB_VALUE=0
PROVIDER_EMBED_DUB_VALUE=1

# Required for provider playback. The official endpoint must return an HTTPS
# playback URL and accept a provider-issued accessId/streamId/id—not an embed URL.
PROVIDER_PLAYBACK_PATH=/stream/{id}
